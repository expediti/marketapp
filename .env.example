# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Payment Gateway Configuration (Abstraction layer: Razorpay / Cashfree)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Meta / Instagram Graph API OAuth (Backend client credentials)
# In production, this must match the Meta App Redirect URI (Cloudflare Worker endpoint):
# https://marketapp.expeditionthe0.workers.dev/api/auth/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://marketapp.expeditionthe0.workers.dev/api/auth/instagram/callback

# App Settings & Canonical Public Production Domain
NEXT_PUBLIC_SITE_URL=https://marketmyidea.online
NEXT_PUBLIC_APP_URL=https://marketmyidea.online
NEXT_PUBLIC_MARKETPLACE_NAME=Market My App
