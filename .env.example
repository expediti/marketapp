# ============================================================================
# MARKETMYIDEA — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local for local development. Never commit real secrets to Git.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Shared with main application)
# ----------------------------------------------------------------------------
# [PUBLIC] Base HTTPS URL of your existing Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [PUBLIC] Anon / Publishable API Key (Safe for browser client, restricted by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# [SERVER-ONLY SECRET] Supabase Service Role Key
# ⚠️ REQUIRED for Admin API Route Handlers. NEVER expose to the browser!
# In Cloudflare Worker production, configure via: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ----------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION & CANONICAL HOSTNAMES
# ----------------------------------------------------------------------------
# [PUBLIC] Canonical site URL for this application instance
# In production: https://admin.marketmyidea.online (or https://marketmyidea.online for main app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETPLACE_NAME=Market My Idea Admin

# ----------------------------------------------------------------------------
# 3. PAYMENT GATEWAY CREDENTIALS (Server-Side Secrets)
# ----------------------------------------------------------------------------
# Required if the admin panel triggers refunds or queries Razorpay APIs
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# ----------------------------------------------------------------------------
# 4. INSTAGRAM GRAPH API / META OAUTH (Preserved Backend Credentials)
# ----------------------------------------------------------------------------
# Maintained for backend sync, webhooks, and future OAuth reactivation
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=https://marketmyidea.online/api/auth/instagram/callback

# ----------------------------------------------------------------------------
# 5. FEATURE FLAGS
# ----------------------------------------------------------------------------
# Public feature flag controlling Instagram OAuth UI visibility (default: false)
NEXT_PUBLIC_INSTAGRAM_OAUTH_ENABLED=false
